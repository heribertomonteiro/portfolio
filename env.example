# Copy this file to .env.local and fill in real values.
# NEVER commit secrets to git.

# SMTP server settings (provided by your email provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Email sender (must be allowed/verified by the provider)
SMTP_FROM="your <no-reply@yourdomain.com>"

# Destination inbox (where you want to receive contact messages)
SMTP_TO=youremail@domain.com
